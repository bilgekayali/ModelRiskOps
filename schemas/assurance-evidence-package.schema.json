{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/assurance-evidence-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id","institution_id","scope_digest","mapping_profile_digests","applicability_assertion_digests","evidence_reference_digests","crosswalk_entry_digests","coverage_summaries","assembled_by_id","assembled_at","certification_claimed","conformity_claimed","legal_compliance_determined","supervisory_acceptance_claimed","requires_human_review"],
  "properties": {
    "package_id": {"type":"string","minLength":1},
    "institution_id": {"type":"string","minLength":1},
    "scope_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mapping_profile_digests": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "applicability_assertion_digests": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "evidence_reference_digests": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "crosswalk_entry_digests": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "coverage_summaries": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["framework","framework_version","required_reference_count","supported_count","partial_count","gap_count","not_applicable_count"],
        "properties": {
          "framework":{"enum":["federal_reserve_sr_26_2","nist_ai_rmf","nist_ai_600_1","iso_iec_42001","eu_ai_act"]},
          "framework_version":{"enum":["SR 26-2","1.0","600-1","2023","2024/1689@2026-07-27"]},
          "required_reference_count":{"type":"integer","minimum":1},
          "supported_count":{"type":"integer","minimum":0},
          "partial_count":{"type":"integer","minimum":0},
          "gap_count":{"type":"integer","minimum":0},
          "not_applicable_count":{"type":"integer","minimum":0}
        }
      }
    },
    "assembled_by_id": {"type":"string","minLength":1},
    "assembled_at": {"type":"integer","minimum":0},
    "certification_claimed": {"const":false},
    "conformity_claimed": {"const":false},
    "legal_compliance_determined": {"const":false},
    "supervisory_acceptance_claimed": {"const":false},
    "requires_human_review": {"const":true}
  }
}
