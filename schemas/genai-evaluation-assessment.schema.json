{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://modelriskops.dev/schemas/genai-evaluation-assessment.schema.json",
  "type":"object","additionalProperties":false,
  "required":["institution_id","model_id","version_id","plan_digest","overlay_snapshot_digest","evaluated_at","state","metric_assessments","gaps","model_safety_determined","regulatory_compliance_determined"],
  "properties":{
    "institution_id":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"version_id":{"type":"string","minLength":1},
    "plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"overlay_snapshot_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evaluated_at":{"type":"integer","minimum":0},"state":{"enum":["healthy","degraded","breached","incomplete"]},
    "metric_assessments":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["metric_id","status","observation_digest","reason"],"properties":{
      "metric_id":{"type":"string","minLength":1},"status":{"enum":["pass","warning","breach","incomplete"]},
      "observation_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"reason":{"type":"string","minLength":1}
    }}},
    "gaps":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "model_safety_determined":{"const":false},"regulatory_compliance_determined":{"const":false}
  }
}