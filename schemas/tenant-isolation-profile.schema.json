{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://modelriskops.dev/schemas/tenant-isolation-profile.schema.json",
  "type":"object","additionalProperties":false,
  "required":["institution_id","tenant_id","profile_version","environment","database_role","namespace_digest","rls_policy_digests","registered_at"],
  "properties":{
    "institution_id":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"profile_version":{"type":"integer","minimum":1},
    "environment":{"enum":["development","test","staging","production"]},"database_role":{"type":"string","pattern":"^[a-z_][a-z0-9_]{0,62}$"},
    "namespace_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rls_policy_digests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "registered_at":{"type":"integer","minimum":0}
  }
}
