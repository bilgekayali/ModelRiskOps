{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/assurance-applicability-assertion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_id","institution_id","scope_digest","framework","framework_version","reference_id","applicability","eu_ai_act_roles","confirmation_basis","confirmed_by_id","confirmed_at"],
  "properties": {
    "assertion_id": {"type":"string","minLength":1},
    "institution_id": {"type":"string","minLength":1},
    "scope_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "framework": {"enum":["federal_reserve_sr_26_2","nist_ai_rmf","nist_ai_600_1","iso_iec_42001","eu_ai_act"]},
    "framework_version": {"enum":["SR 26-2","1.0","600-1","2023","2024/1689@2026-07-27"]},
    "reference_id": {"type":"string","minLength":1},
    "applicability": {"enum":["applicable","not_applicable"]},
    "eu_ai_act_roles": {"type":"array","uniqueItems":true,"items":{"enum":["provider","deployer","authorised_representative","importer","distributor","product_manufacturer"]}},
    "confirmation_basis": {"type":"string","minLength":1},
    "confirmed_by_id": {"type":"string","minLength":1},
    "confirmed_at": {"type":"integer","minimum":0}
  }
}
