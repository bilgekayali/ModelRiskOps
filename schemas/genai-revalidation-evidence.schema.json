{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://modelriskops.dev/schemas/genai-revalidation-evidence.schema.json",
  "type":"object","additionalProperties":false,
  "required":["institution_id","model_id","before_overlay_digest","after_overlay_digest","triggers","revalidation_requirement_digest","rationale"],
  "properties":{
    "institution_id":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},
    "before_overlay_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"after_overlay_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "triggers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["foundation_model","prompt_policy","retrieval_corpus","embedding_model","tool_scope","safety_policy"]}},
    "revalidation_requirement_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"rationale":{"type":"string","minLength":1}
  }
}