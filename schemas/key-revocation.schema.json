{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.local/schemas/key-revocation.schema.json",
  "title": "ModelRiskOps Key Revocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "key_id", "key_digest", "revoked_by_id", "reason", "revoked_at"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "key_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revoked_by_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "revoked_at": {"type": "integer", "minimum": 0}
  }
}
