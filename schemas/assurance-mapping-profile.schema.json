{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/assurance-mapping-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","profile_id","profile_version","framework","framework_version","reference_ids","source_document_digest","owner_id","registered_at"],
  "properties": {
    "institution_id": {"type":"string","minLength":1},
    "profile_id": {"type":"string","minLength":1},
    "profile_version": {"type":"integer","minimum":1},
    "framework": {"enum":["federal_reserve_sr_26_2","nist_ai_rmf","nist_ai_600_1","iso_iec_42001","eu_ai_act"]},
    "framework_version": {"enum":["SR 26-2","1.0","600-1","2023","2024/1689@2026-07-27"]},
    "reference_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "source_document_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "owner_id": {"type":"string","minLength":1},
    "registered_at": {"type":"integer","minimum":0}
  }
}
