{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/portfolio-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","portfolio_id","snapshot_version","inventory_snapshot_digest","positions","as_of_time"],
  "properties": {
    "institution_id": {"type":"string","minLength":1},
    "portfolio_id": {"type":"string","minLength":1},
    "snapshot_version": {"type":"integer","minimum":1},
    "inventory_snapshot_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "positions": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required": [
          "institution_id","model_id","version_id","model_version_digest","risk_decision_digest",
          "residual_risk_tier","exposure_weight_bps","third_party_dependency_digests"
        ],
        "properties": {
          "institution_id": {"type":"string","minLength":1},
          "model_id": {"type":"string","minLength":1},
          "version_id": {"type":"string","minLength":1},
          "model_version_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
          "risk_decision_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
          "residual_risk_tier": {"enum":["low","medium","high","critical"]},
          "exposure_weight_bps": {"type":"integer","minimum":1,"maximum":10000},
          "third_party_dependency_digests": {
            "type":"array","uniqueItems":true,
            "items":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "as_of_time": {"type":"integer","minimum":0}
  }
}
