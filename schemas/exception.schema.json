{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/exception.schema.json",
  "title": "ModelRiskOps Exception Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["exception_id", "institution_id", "model_id", "version_id", "model_version_digest", "risk_decision_digest", "waived_requirement_ids", "owner_id", "rationale", "compensating_controls", "issued_at", "expires_at", "one_time"],
  "properties": {
    "exception_id": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "version_id": {"type": "string", "minLength": 1},
    "model_version_digest": {"$ref": "#/$defs/sha256"},
    "risk_decision_digest": {"$ref": "#/$defs/sha256"},
    "waived_requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "owner_id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "compensating_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 1},
    "one_time": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
