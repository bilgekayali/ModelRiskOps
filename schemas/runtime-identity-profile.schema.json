{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/runtime-identity-profile.schema.json",
  "title": "RuntimeIdentityProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","tenant_id","profile_version","environment","workload_identity","service_account","issuer_digest","audience_digest","tenant_isolation_profile_digest","registered_at"],
  "properties": {
    "institution_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "profile_version": {"type":"integer","minimum":1},
    "environment": {"enum":["development","staging","production"]},
    "workload_identity": {"type":"string","minLength":1},
    "service_account": {"type":"string","minLength":1},
    "issuer_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "audience_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "tenant_isolation_profile_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "registered_at": {"type":"integer","minimum":1}
  }
}