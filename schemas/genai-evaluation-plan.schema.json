{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://modelriskops.dev/schemas/genai-evaluation-plan.schema.json",
  "type":"object","additionalProperties":false,
  "required":["institution_id","model_id","version_id","model_version_digest","overlay_snapshot_digest","evaluator_owner_id","metrics","planned_at"],
  "properties":{
    "institution_id":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"version_id":{"type":"string","minLength":1},
    "model_version_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"overlay_snapshot_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evaluator_owner_id":{"type":"string","minLength":1},"planned_at":{"type":"integer","minimum":0},
    "metrics":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["metric_id","kind","direction","pass_threshold","warning_threshold","minimum_sample_size","max_age_seconds"],"properties":{
      "metric_id":{"type":"string","minLength":1},
      "kind":{"enum":["factuality","groundedness","harmful_content","prompt_injection_resistance","privacy_leakage","fairness_bias","tool_control","operational_robustness"]},
      "direction":{"enum":["higher_is_better","lower_is_better"]},
      "pass_threshold":{"type":"number"},"warning_threshold":{"type":["number","null"]},
      "minimum_sample_size":{"type":"integer","minimum":1},"max_age_seconds":{"type":"integer","minimum":1}
    }}}
  }
}