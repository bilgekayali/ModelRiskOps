{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/risk-policy.schema.json",
  "title": "ModelRiskOps Risk Policy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "policy_id",
    "version",
    "weights",
    "medium_threshold",
    "high_threshold",
    "critical_threshold",
    "max_control_credit",
    "requirement_sets"
  ],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "weights": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor", "weight"],
        "properties": {
          "factor": {"$ref": "#/$defs/factor"},
          "weight": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    },
    "medium_threshold": {"type": "integer", "minimum": 1},
    "high_threshold": {"type": "integer", "minimum": 1},
    "critical_threshold": {"type": "integer", "minimum": 1},
    "max_control_credit": {"type": "integer", "minimum": 0},
    "requirement_sets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "requirements"],
        "properties": {
          "tier": {"$ref": "#/$defs/tier"},
          "requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "factor": {
      "enum": [
        "decision_impact",
        "customer_financial_impact",
        "autonomy",
        "complexity",
        "data_sensitivity",
        "external_dependency",
        "explainability_need",
        "regulatory_relevance",
        "deployment_criticality"
      ]
    },
    "tier": {"enum": ["low", "medium", "high", "critical"]}
  }
}
