{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/foundation-model-dependency.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","model_id","version_id","provider","provider_model_id","provider_model_version","deployment_id","owner_id","artifact_digest","config_digest","terms_evidence_digest","registered_at"],
  "properties": {
    "institution_id": {"type":"string","minLength":1},
    "model_id": {"type":"string","minLength":1},
    "version_id": {"type":"string","minLength":1},
    "provider": {"type":"string","minLength":1},
    "provider_model_id": {"type":"string","minLength":1},
    "provider_model_version": {"type":"string","minLength":1},
    "deployment_id": {"type":"string","minLength":1},
    "owner_id": {"type":"string","minLength":1},
    "artifact_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "config_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "terms_evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "registered_at": {"type":"integer","minimum":0}
  }
}