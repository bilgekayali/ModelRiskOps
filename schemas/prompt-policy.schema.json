{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/prompt-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","model_id","version_id","prompt_policy_id","policy_version","owner_id","intended_purpose","prompt_digest","safety_policy_digest","prohibited_behaviors","registered_at"],
  "properties": {
    "institution_id": {"type":"string","minLength":1},
    "model_id": {"type":"string","minLength":1},
    "version_id": {"type":"string","minLength":1},
    "prompt_policy_id": {"type":"string","minLength":1},
    "policy_version": {"type":"string","minLength":1},
    "owner_id": {"type":"string","minLength":1},
    "intended_purpose": {"type":"string","minLength":1},
    "prompt_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "safety_policy_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prohibited_behaviors": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "registered_at": {"type":"integer","minimum":0}
  }
}