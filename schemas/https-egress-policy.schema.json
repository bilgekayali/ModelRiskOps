{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/https-egress-policy.schema.json",
  "title": "HttpsEgressPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id","tenant_id","policy_id","policy_version","allowed_https_hosts","tls_required","default_deny","wildcard_hosts_allowed","raw_ip_egress_allowed","registered_at"],
  "properties": {
    "institution_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "policy_id": {"type":"string","minLength":1},
    "policy_version": {"type":"integer","minimum":1},
    "allowed_https_hosts": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(?=.{1,253}$)(?!-)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"}},
    "tls_required": {"const":true},
    "default_deny": {"const":true},
    "wildcard_hosts_allowed": {"const":false},
    "raw_ip_egress_allowed": {"const":false},
    "registered_at": {"type":"integer","minimum":1}
  }
}