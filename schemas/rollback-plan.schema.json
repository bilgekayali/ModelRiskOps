{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://modelriskops.dev/schemas/rollback-plan.schema.json",
  "title":"RollbackPlan",
  "type":"object",
  "additionalProperties":false,
  "required":["institution_id","tenant_id","release_id","release_version","restore_artifact_digest","configuration_restore_digest","data_recovery_procedure_digest","rollback_validation_digest","declared_at"],
  "properties":{
    "institution_id":{"type":"string","minLength":1},
    "tenant_id":{"type":"string","minLength":1},
    "release_id":{"type":"string","minLength":1},
    "release_version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "restore_artifact_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "configuration_restore_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "data_recovery_procedure_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "rollback_validation_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "declared_at":{"type":"integer","minimum":1}
  }
}