{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.dev/schemas/supported-upgrade-path.schema.json",
  "title": "ModelRiskOps Supported Upgrade Path v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_series", "target_version", "source_release_digest", "target_release_digest",
    "preflight_evidence_digest", "migration_evidence_digest", "post_upgrade_validation_digest",
    "rollback_evidence_digest", "backup_required", "breaking_changes_declared", "declared_at"
  ],
  "properties": {
    "source_series": {"const": "0.8.x"},
    "target_version": {"const": "1.0.0"},
    "source_release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_upgrade_validation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rollback_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backup_required": {"const": true},
    "breaking_changes_declared": {"const": false},
    "declared_at": {"type": "integer", "minimum": 1}
  }
}
