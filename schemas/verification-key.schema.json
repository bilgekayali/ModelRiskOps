{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelriskops.local/schemas/verification-key.schema.json",
  "title": "ModelRiskOps Verification Key Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution_id", "key_id", "owner_id", "public_key_base64", "permitted_roles", "valid_from", "valid_until", "registered_at", "algorithm"],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "public_key_base64": {"type": "string", "minLength": 44, "maxLength": 44},
    "permitted_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "valid_from": {"type": "integer", "minimum": 0},
    "valid_until": {"type": ["integer", "null"], "minimum": 0},
    "registered_at": {"type": "integer", "minimum": 0},
    "algorithm": {"const": "ed25519"}
  }
}
